{
  "name": "calyx-logger",
  "version": "0.3.2",
  "description": "Ship frontend and backend logs to Calyx — Next plugin (withCalyxLogger) or init().",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.js"
    },
    "./next/register": {
      "types": "./dist/next/register.d.ts",
      "import": "./dist/next/register.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/next/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=15.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "calyx",
    "logging",
    "observability",
    "browser",
    "node",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnab-Afk/calyx.git",
    "directory": "packages/logger"
  },
  "engines": {
    "node": ">=18"
  }
}
