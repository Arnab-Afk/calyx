# ── Infrastructure ────────────────────────────────────────────────────────────
# Local (outside Docker): use localhost. docker compose overrides these for app services.
DATABASE_URL=postgres://calyx:calyx@localhost:5432/calyx
REDIS_URL=redis://localhost:6379

# Docker quickstart:
#   cp .env.example .env   # fill ANTHROPIC_API_KEY (+ Slack vars if using Slack)
#   docker compose up --build
#   curl http://localhost:13000/health
# Host ports: ingestion 13000, Slack 13001, Postgres 15432, Redis 16379
# With Slack (Socket Mode): docker compose --profile slack up --build
# From the host (CLI/tools), use:
#   DATABASE_URL=postgres://calyx:calyx@localhost:15432/calyx
#   REDIS_URL=redis://localhost:16379

# Private S3-compatible chat uploads (Cloudflare R2 in production)
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=calyx-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=calyx-minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=calyx-minio-secret
OBJECT_STORAGE_PATH_STYLE=true
# On ECS use task-role credentials instead: OBJECT_STORAGE_USE_IAM=true

# ── Ingestion server ──────────────────────────────────────────────────────────
PORT=3000

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the Slack on-call model (defaults to claude-opus-5).
# Slack ignores CALYX_PROVIDER — Nemotron is CLI-only.
# CALYX_SLACK_MODEL=claude-opus-5
# Fast Slack "I'm on it" line while Opus investigates
# CALYX_ACK_MODEL=claude-haiku-4-5

# NVIDIA Build — spare for CLI only (`calyx ask --provider nvidia ...`)
# Do not point Slack at these. Nemotron is faster than Opus, not as accurate.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# CALYX_NVIDIA_THINKING=false
# CALYX_NVIDIA_REASONING_BUDGET=1024

# ── MCP coding-agent connectors ───────────────────────────────────────────────
# Local stdio binds every tool call to this tenant. Alternatively set CALYX_API_KEY.
CALYX_TENANT_ID=default
# CALYX_MCP_SCOPES=logs:read
# Hosted Streamable HTTP endpoint: http://localhost:13002/mcp
MCP_PORT=3002
# MCP_HOST=0.0.0.0
# Stateless is horizontally safe and recommended. Stateful requires load-balancer affinity.
MCP_SESSION_MODE=stateless
# Shared PostgreSQL-backed limit per authenticated credential (requests/minute).
MCP_RATE_LIMIT_PER_MINUTE=120
# Optional external OAuth 2.1/OIDC authorization server with RFC 7662 introspection.
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# MCP_OAUTH_ISSUER=https://auth.example.com
# MCP_OAUTH_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
# MCP_OAUTH_CLIENT_ID=calyx-mcp
# MCP_OAUTH_CLIENT_SECRET=replace-with-secret
# Server-to-server secret shared by Go chat API and Node intake.
CALYX_INTERNAL_API_KEY=replace-with-a-random-secret
# Go chat API: Node origin for /calyx investigations + workspace tenant auto-link.
CALYX_ASK_URL=http://localhost:13000
CALYX_DEFAULT_TENANT=default

# ── Go chat API ───────────────────────────────────────────────────────────────
# APP_ENV=development
# Production requires a random secret of at least 32 characters.
# JWT_SECRET=replace-with-at-least-32-random-characters
# JWT_ISSUER=calyx-chat-api
# JWT_AUDIENCE=calyx-web
# JWT_TTL_HOURS=24
# Production must list explicit HTTPS web origins; wildcard CORS is rejected.
# CORS_ORIGINS=https://app.example.com
# Cross-origin SPA (Vercel → API host): omit COOKIE_DOMAIN; production defaults SameSite=None.
# COOKIE_SAMESITE=none
# Sibling subdomains: COOKIE_SAMESITE=lax and COOKIE_DOMAIN=.example.com
# COOKIE_DOMAIN=
# Browser OAuth (optional). Redirect URLs must match the Go chat API public host.
# WEB_APP_URL=https://app.example.com
# Used by ingestion for CLI device-login links (calyx journal)
# CALYX_WEB_URL=https://app.example.com
# Public intake base (no /v1/logs suffix) — used in source-token copy snippets & GitHub webhooks
# CALYX_PUBLIC_URL=https://intake.example.com
# CALYX_INTAKE_URL=https://intake.example.com
# CALYX_PUBLIC_INTAKE_URL=https://intake.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://api.example.com/v1/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=https://api.example.com/v1/auth/github/callback

# ── Slack ─────────────────────────────────────────────────────────────────────
# One-time Slack app setup (no OAuth in v1):
# 1. Create a Slack app with Bot Token Scopes: chat:write, app_mentions:read,
#    channels:history, groups:history, im:history, reactions:write
# 2. Enable Socket Mode (or Events API) and subscribe to app_mention + message.*
# 3. Install to your workspace; put Bot User OAuth Token in SLACK_BOT_TOKEN
# 4. In Calyx Settings → Integrations, bind the channel ID (C…) for each project
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...        # only needed for Socket Mode
SLACK_SOCKET_MODE=true          # set to false if using HTTP/ngrok
SLACK_PORT=3001
# Comma-separated Slack user IDs allowed to approve/reject remediation. Empty denies everyone.
SLACK_REMEDIATION_APPROVER_IDS=U0123456789
# Multi-workspace override: SLACK_REMEDIATION_APPROVER_IDS_T0123456789=U0123456789,U9876543210

# Tenant-scoped customer operator endpoints. Secrets must be at least 32 characters.
# Production endpoints must use HTTPS. Never expose this value to browser code.
# CALYX_OPERATOR_CONFIG={"tenant-a":{"url":"https://operator.example.com/calyx/actions","secret":"replace-with-32+-character-secret","allowed_operations":["service.scale","deploy.rollback"]}}
CALYX_OPERATOR_TIMEOUT_MS=10000

# GitHub App + external coding-agent dispatcher. Private key may contain escaped newlines.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
CALYX_CODING_AGENT_URL=https://coding-agent.example.com/jobs
# Bot events: app_mention, message.channels, message.groups, message.im
# (thread replies and DMs do not require @Calyx once the bot is in the thread)

# ── Detection and autonomous alert delivery ──────────────────────────────────
CALYX_DETECTION_INTERVAL_MS=60000
CALYX_ACTIVE_SERVICE_LOOKBACK_HOURS=24
# Exact tenant-to-channel mapping for multi-tenant deployments:
# CALYX_SLACK_ALERT_CHANNELS={"tenant-a":"C0123456789","tenant-b":"C9876543210"}
# Single-tenant fallback; only used when CALYX_TENANT_ID matches the event tenant:
# CALYX_SLACK_ALERT_CHANNEL=C0123456789

# ── Tenant mapping (optional) ─────────────────────────────────────────────────
# Maps a Slack workspace ID to a Calyx tenant ID.
# If omitted, the workspace ID is used as the tenant ID.
# CALYX_TENANT_T012345678=my-company
