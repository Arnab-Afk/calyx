# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Chat backend. Keep `convex` until the coordinated screen migration is complete.
NEXT_PUBLIC_CHAT_BACKEND=convex
# First-party Go chat API (sends HTTP-only session cookies)
NEXT_PUBLIC_CALYX_CHAT_URL=http://localhost:14000

# Calyx observability backend (ask + logs)
CALYX_API_URL=http://localhost:13000
NEXT_PUBLIC_CALYX_MCP_URL=http://localhost:13002/mcp

# MCP credential actions and trusted workspace asks run server-side.
# Configure these with `pnpm exec convex env set`; never expose the internal key publicly.
# CALYX_API_URL=http://localhost:13000
# CALYX_INTERNAL_API_KEY=generate-a-long-random-secret

# calyx-logger (frontend) — write-only source token from:
#   calyx sources create --project <slug> --role frontend --service web
NEXT_PUBLIC_CALYX_INTAKE_URL=http://localhost:13000/v1/logs
NEXT_PUBLIC_CALYX_SOURCE_TOKEN=
NEXT_PUBLIC_CALYX_SERVICE=web
