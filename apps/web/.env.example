# First-party Go chat API. Browser sessions use HTTP-only cookies.
NEXT_PUBLIC_CALYX_CHAT_URL=https://calyx-api.arnabbhowmik.in

# Hosted Streamable HTTP MCP endpoint shown in connector setup.
NEXT_PUBLIC_CALYX_MCP_URL=https://YOUR_MCP_HOST/mcp

# Observability API (Control Center → Projects & logs). Server-only.
CALYX_API_URL=https://YOUR_INTAKE_HOST
CALYX_MGMT_TOKEN=calyx_mgmt_…
