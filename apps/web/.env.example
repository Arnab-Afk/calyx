# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Calyx backend (ask + logs)
CALYX_API_URL=http://localhost:13000
NEXT_PUBLIC_CALYX_TENANT_ID=default
NEXT_PUBLIC_CALYX_MCP_URL=http://localhost:13002/mcp

# MCP credential actions run inside Convex, so configure these with `pnpm exec convex env set`.
# CALYX_API_URL=http://localhost:13000
# CALYX_INTERNAL_API_KEY=generate-a-long-random-secret

# calyx-logger (frontend) — write-only source token from:
#   calyx sources create --project <slug> --role frontend --service web
NEXT_PUBLIC_CALYX_INTAKE_URL=http://localhost:13000/v1/logs
NEXT_PUBLIC_CALYX_SOURCE_TOKEN=
NEXT_PUBLIC_CALYX_SERVICE=web
