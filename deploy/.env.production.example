# Immutable images built from the same commit
CALYX_NODE_IMAGE=ghcr.io/example/calyx-node@sha256:replace
CALYX_CHAT_IMAGE=ghcr.io/example/calyx-chat@sha256:replace

NODE_ENV=production
APP_ENV=production
DATABASE_URL=postgresql://user:password@db.example:5432/calyx?sslmode=require
REDIS_URL=rediss://default:password@redis.example:6379

CALYX_INTERNAL_API_KEY=replace-with-independent-32-byte-secret
JWT_SECRET=replace-with-independent-32-byte-secret
JWT_ISSUER=calyx-chat-api
JWT_AUDIENCE=calyx-web
CORS_ORIGINS=https://app.example.com
COOKIE_SAMESITE=none
CALYX_DEFAULT_TENANT=default

CALYX_PUBLIC_URL=https://intake.example.com
CALYX_INTAKE_URL=https://intake.example.com
CALYX_ASK_URL=https://intake.example.com
PORT=3000

MCP_HOST=0.0.0.0
MCP_PORT=3002
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_SESSION_MODE=stateless
MCP_OAUTH_ISSUER=https://identity.example.com/
MCP_OAUTH_INTROSPECTION_URL=https://identity.example.com/oauth/introspect
MCP_OAUTH_CLIENT_ID=replace
MCP_OAUTH_CLIENT_SECRET=replace

OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=calyx-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=replace
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace
OBJECT_STORAGE_PATH_STYLE=false

GITHUB_APP_ID=replace
GITHUB_APP_SLUG=calyx
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----"
CALYX_CODING_AGENT_URL=https://coding-agent.example.com/jobs

ANTHROPIC_API_KEY=replace
CALYX_PROVIDER=anthropic

# Enable the Slack Compose profile only after these are configured.
REQUIRE_SLACK=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE=true
SLACK_REMEDIATION_APPROVER_IDS={}

# Server-only web deployment variables (configure on Vercel/web host).
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_CALYX_CHAT_URL=https://chat.example.com
NEXT_PUBLIC_CALYX_MCP_URL=https://mcp.example.com/mcp
CALYX_CHAT_URL=https://chat.example.com
CALYX_API_URL=https://intake.example.com
CALYX_MGMT_TOKEN=calyx_mgmt_replace

# Set only when transport encryption is guaranteed by a private managed network.
DATABASE_TLS_ASSURED=false
ALLOW_PRIVATE_PLAINTEXT_REDIS=false
